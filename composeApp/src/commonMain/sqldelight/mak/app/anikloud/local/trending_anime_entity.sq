CREATE TABLE IF NOT EXISTS `trending_animes` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `anime_id` TEXT NOT NULL,
    `page` INTEGER AS kotlin.Int NOT NULL,
    FOREIGN KEY(`anime_id`) REFERENCES `animes`(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

getTrendingAnimes:
SELECT animes.* FROM trending_animes INNER JOIN animes ON animes.id = trending_animes.anime_id ORDER BY page ASC LIMIT :limit OFFSET :offset;

insertAnime:
INSERT OR IGNORE INTO trending_animes (id, anime_id, page) VALUES (nullif(:id, 0), :anime_id, :page);

update:
UPDATE trending_animes SET `anime_id` = :animeId, `page` = :page WHERE id = :id;

deletePage:
DELETE FROM trending_animes WHERE page=:page;

delete:
DELETE FROM trending_animes WHERE id=:id;

deleteAll:
DELETE FROM trending_animes;