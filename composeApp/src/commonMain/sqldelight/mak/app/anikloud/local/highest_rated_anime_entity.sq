CREATE TABLE IF NOT EXISTS `top_animes` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `anime_id` TEXT NOT NULL,
    `page` INTEGER AS kotlin.Int NOT NULL,
    FOREIGN KEY(`anime_id`) REFERENCES `animes`(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

getAiringAnimes:
SELECT animes.* FROM top_animes INNER JOIN animes ON animes.id = top_animes.anime_id ORDER BY page ASC;

insertAnime:
INSERT OR IGNORE INTO top_animes (id, anime_id, page) VALUES (nullif(:id, 0), :anime_id, :page);

deletePage:
DELETE FROM top_animes WHERE page=:page;

deleteAll:
DELETE FROM top_animes;