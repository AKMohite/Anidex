CREATE TABLE IF NOT EXISTS `popular_animes` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `anime_id` TEXT NOT NULL,
    `page` INTEGER AS kotlin.Int NOT NULL,
    FOREIGN KEY(`anime_id`) REFERENCES `animes`(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

getPopularAnimes:
SELECT animes.* FROM popular_animes INNER JOIN animes ON animes.id = popular_animes.anime_id ORDER BY page ASC;

insertAnime:
INSERT OR IGNORE INTO popular_animes (id, anime_id, page) VALUES (nullif(:id, 0), :anime_id, :page);

update:
UPDATE popular_animes SET `anime_id` = :animeId, `page` = :page WHERE id = :id;

entriesInPage:
SELECT animes.* FROM popular_animes INNER JOIN animes ON animes.id = popular_animes.anime_id WHERE page=:page ORDER BY page ASC;

delete:
DELETE FROM popular_animes WHERE id = :id;

deletePage:
DELETE FROM popular_animes WHERE page=:page;

deleteAll:
DELETE FROM popular_animes;